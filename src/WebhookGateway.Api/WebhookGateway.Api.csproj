<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Secretos de desarrollo local (cadena de conexión, claves) fuera del repo.
         Se cargan solo en el entorno Development. En producción llegan por variables
         de entorno. Ver el bloque "//Secretos" de appsettings.json. -->
    <UserSecretsId>webhookgateway-api</UserSecretsId>
  </PropertyGroup>

  <!--
		Smart App Control de Windows bloquea el .exe que genera el SDK, porque se
		crea nuevo en cada build y no lleva firma reconocida. Sin apphost, la app
		se ejecuta con dotnet.exe, que si esta firmado por Microsoft.
		Solo en Debug: la publicacion a produccion sigue generando su .exe.
	-->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!--
		appsettings.Development.json NO se publica. Sigue copiandose al compilar, asi que depurar
		en local funciona igual; lo que se evita es mandarlo al servidor.

		Dos razones. Lleva una cadena de conexion con contrasena apuntando a WebhookGateway_dev, y
		eso no tiene nada que hacer en produccion. Y aunque con ASPNETCORE_ENVIRONMENT=Production no
		se cargue, si el archivo esta ahi basta con que alguien defina ese entorno como Development
		para que produccion empiece a escribir en la base de desarrollo. Si el archivo no viaja, esa
		puerta no existe.
	-->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebhookGateway.Core\WebhookGateway.Core.csproj" />
    <ProjectReference Include="..\WebhookGateway.Data\WebhookGateway.Data.csproj" />
    <ProjectReference Include="..\WebhookGateway.Dispatcher\WebhookGateway.Dispatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebhookGateway.IntegrationTests" />
  </ItemGroup>

</Project>
