<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de IIS. Solo la lee IIS: en Docker o con Kestrel a pelo este archivo se ignora,
    así que no afecta al despliegue en Render.

    El SDK rellena processPath y arguments al publicar; lo que se fija aquí es lo que el valor por
    defecto no da bien.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
          shutdownTimeLimit: segundos que el módulo de IIS espera a que el proceso termine solo antes
          de matarlo. El valor por defecto son 10, y no alcanza: el apagado ordenado del despachador
          espera a las entregas en vuelo, vuelca los resultados y libera sus leases, con 15 segundos
          de margen propio (Gateway:Dispatcher:ShutdownGraceSeconds). Si lo matan antes, los leases se
          quedan colgados y esas entregas no vuelven a la cola hasta vencer, tres minutos después, en
          cada reciclaje del pool.

          Los tres plazos tienen que ir en escalera, de menor a mayor:
            ShutdownGraceSeconds (15)  <  HostOptions.ShutdownTimeout (30)  <  shutdownTimeLimit (45)

          hostingModel="inprocess": la app corre dentro de w3wp. Es lo más rápido, y es también la
          razón por la que el tiempo de inactividad del pool importa tanto: si IIS duerme el proceso,
          el despachador deja de despachar. Ver docs/despliegue-iis.md.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\WebhookGateway.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  shutdownTimeLimit="45">
        <environmentVariables>
          <!--
              Explícito a propósito. Sin esta variable el entorno ya sería Production, pero dejarlo
              implícito significa que basta con que alguien defina ASPNETCORE_ENVIRONMENT=Development
              en la máquina para que se cargue appsettings.Development.json y producción empiece a
              escribir en WebhookGateway_dev sin que nadie se entere. Esto cierra esa puerta.
          -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
